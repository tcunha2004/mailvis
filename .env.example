# ---- LLM provider (AWS Bedrock) -------------------------------------------
# Option A: Bedrock API key (https://docs.aws.amazon.com/bedrock/latest/userguide/api-keys.html)
AWS_BEARER_TOKEN_BEDROCK=
# Option B: regular IAM credentials (leave the token above empty)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ---- Models (optional, any LangChain "provider:model" string) -------------
# LLM_MODEL=bedrock_converse:global.anthropic.claude-haiku-4-5-20251001-v1:0
# EMBEDDING_MODEL=bedrock:amazon.titan-embed-text-v2:0
# EMBEDDING_DIMS=1024

# ---- Docker Compose (optional) ---------------------------------------------
# POSTGRES_USER=mailvis
# POSTGRES_PASSWORD=mailvis
# POSTGRES_DB=mailvis
# POSTGRES_PORT=5432
# API_PORT=8000
# WEB_PORT=3000
